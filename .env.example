# ============================================================
# Asset Explorer — Environment Variables Reference
# ============================================================
# Copy to .env and fill in your values.
# NEVER commit .env to source control — it is in .gitignore.
#
# In production, all secrets are injected via OCI Vault
# (fetched by entrypoint.sh using OCI Resource Principal at startup).
# ============================================================


# ── App Mode ─────────────────────────────────────────────────
# Set MOCK_MODE=true to run without any external credentials.
# The app uses sample_data/ files and returns synthetic responses.
MOCK_MODE=true

# ── SAML / SSO ───────────────────────────────────────────────
# Secret key for signing JWT tokens (minimum 32 random characters)
JWT_SECRET=change-me-to-32-random-chars-minimum

# SAML Identity Provider metadata URL (from your enterprise IdP)
SAML_IDP_METADATA_URL=https://your-idp.example.com/metadata

# SAML Service Provider entity ID (matches your SP registration)
SAML_SP_ENTITY_ID=https://asset-explorer.your-company.com

# ACS URL — where IdP posts the SAML response
SAML_ACS_URL=https://asset-explorer.your-company.com/api/saml/acs

# After SAML success, redirect frontend here with ?token= query param
SAML_SUCCESS_REDIRECT=https://asset-explorer.your-company.com

# ── Oracle Autonomous Database ────────────────────────────────
# TNS alias from tnsnames.ora (wallet must be mounted at DB_WALLET_DIR)
DB_DSN=asset_explorer_high

# Directory containing wallet files (ewallet.pem, tnsnames.ora, sqlnet.ora)
# In production: fetched from OCI Vault by entrypoint.sh
DB_WALLET_DIR=/app/wallet

# Oracle DB credentials (use a read-only service account for the app)
DB_USER=asset_explorer_app
DB_PASSWORD=your-oracle-password-here

# Number of worker threads for parallel Oracle queries (ThreadPoolExecutor)
DB_THREAD_WORKERS=4

# ── OCI Vault (production wallet fetch) ──────────────────────
# These are only needed when running the real entrypoint.sh.
# MOCK_MODE bypasses wallet fetch entirely.
OCI_REGION=uk-london-1
VAULT_ID=ocid1.vault.oc1.uk-london-1.aaaa...
VAULT_SECRET_EWALLET=ocid1.vaultsecret.oc1.uk-london-1.aaaa...
VAULT_SECRET_TNSNAMES=ocid1.vaultsecret.oc1.uk-london-1.bbbb...
VAULT_SECRET_SQLNET=ocid1.vaultsecret.oc1.uk-london-1.cccc...

# ── Azure OpenAI ─────────────────────────────────────────────
AZURE_OPENAI_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-02-01

# ── Azure AI Search (RAG vector index) ───────────────────────
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your-search-admin-key-here
AZURE_SEARCH_INDEX=asset-health-index

# ── Azure AI Vision (inspection image analysis) ───────────────
AZURE_VISION_ENDPOINT=https://your-vision.cognitiveservices.azure.com
AZURE_VISION_KEY=your-vision-key-here

# ── Fulcrum (field inspection app) ───────────────────────────
FULCRUM_API_KEY=your-fulcrum-api-key-here
FULCRUM_BASE_URL=https://api.fulcrumapp.com/api/v2

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated allowed origins for the FastAPI backend
CORS_ORIGINS=http://localhost:5173,https://asset-explorer.your-company.com

# ── Frontend (Vite) ──────────────────────────────────────────
# Prefix: VITE_ — only these are embedded in the browser bundle
VITE_MOCK_MODE=true
VITE_API_BASE_URL=http://localhost:8000

# ── Monitoring ────────────────────────────────────────────────
# Dynatrace RUM URL (injected into index.html by frontend Dockerfile)
# Leave blank if not using Dynatrace
DYNATRACE_RUM_URL=
